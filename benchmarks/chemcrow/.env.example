# Optional model overrides. ChemCrowRun init writes the selected model into the run workspace.
OPENEVO_CANDIDATE_MODEL=
OPENEVO_REFLECTOR_MODEL=
OPENEVO_EVOLUTION_EVALUATOR_MODEL=
OPENEVO_FINAL_EVALUATOR_MODEL=

# Optional hosted chemistry and search services.
RXN4CHEM_API_KEY=
RXN4CHEM_PROJECT_ID=
RXN4CHEMISTRY_BASE_URL=
SERP_API_KEY=

# Local RXN endpoints are populated by the ChemCrowRun launcher.
CHEMCROW_RXN_PREDICT_URL=
CHEMCROW_RXN_RETRO_URL=
CHEMCROW_RXN_TIMEOUT_SECONDS=

# Required acknowledgement for a paid full experiment.
CHEMCROW_FULL_RUN_AUTHORIZATION=
