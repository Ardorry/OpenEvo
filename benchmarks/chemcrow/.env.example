RXN4CHEM_API_KEY=
RXN4CHEM_PROJECT_ID=
RXN4CHEMISTRY_BASE_URL=
# Excluded from the reduced benchmark profile; keep empty unless the protocol changes.
CHEMSPACE_API_KEY=
# Optional WebSearch provider credential.
SERP_API_KEY=
# Excluded LiteratureSearch credential.
SEMANTIC_SCHOLAR_API_KEY=
CHEMCROW_RXN_PREDICT_URL=
CHEMCROW_RXN_RETRO_URL=
CHEMCROW_RXN_TIMEOUT_SECONDS=
CHEMCROW_FULL_RUN_AUTHORIZATION=
# Sealed-output-only paper evaluator. Put the real key only in an ignored
# permission-0600 env file; never in this example or Git.
